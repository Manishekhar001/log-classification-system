# ============================================================
# Log Classifier - Environment Variables
# ============================================================
# Copy this to .env.production on the server.
# GitHub Actions will write this automatically on deploy.
# ============================================================

# --- REQUIRED ---

# Groq API key for LLM-based classification (LegacyCRM logs)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=gsk_your_api_key_here

# --- OPTIONAL ---

# LLM model to use (default: deepseek-r1-distill-llama-70b)
# LLM_MODEL=deepseek-r1-distill-llama-70b

# LLM temperature (default: 0.5)
# LLM_TEMPERATURE=0.5

# LLM cache size (default: 128)
# LLM_CACHE_SIZE=128

# BERT embedding model (default: all-MiniLM-L6-v2)
# BERT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# BERT minimum confidence threshold (default: 0.5)
# BERT_CONFIDENCE_THRESHOLD=0.5

# Strategy toggles (set to "false" to disable)
# ENABLE_REGEX=true
# ENABLE_BERT=true
# ENABLE_LLM=true

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Minimum log message length to classify (default: 3)
# MIN_LOG_LENGTH=3

# LLM API timeout in seconds (default: 30)
# LLM_TIMEOUT=30
